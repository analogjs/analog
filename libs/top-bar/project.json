{
  "name": "top-bar",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/top-bar/src",
  "prefix": "analogjs",
  "tags": [],
  "implicitDependencies": ["vite-plugin-angular"],
  "targets": {
    "assert-deps": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/assert-project-dependency.mts top-bar build vite-plugin-angular:build"
      }
    },
    "build": {
      "dependsOn": ["assert-deps", "vite-plugin-angular:build"],
      "outputs": ["{projectRoot}/{options.outDir}", "{projectRoot}/dist"],
      "defaultConfiguration": "production",
      "options": {
        "config": "./vite.config.ts",
        "outDir": "../../dist/libs/top-bar"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "sourcemap": true,
          "mode": "production"
        }
      }
    }
  }
}
