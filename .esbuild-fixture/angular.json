{
  "$schema": "../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "fixture": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@analogjs/platform:application",
          "options": {
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "ssr": true,
            "prerender": true,
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "outputPath": "dist-cli",
            "optimization": false,
            "sourceMap": false,
            "progress": false,
            "outputHashing": "none"
          }
        }
      }
    }
  }
}
