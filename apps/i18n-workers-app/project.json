{
  "name": "i18n-workers-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/i18n-workers-app/src",
  "prefix": "analogjs",
  "tags": [],
  "implicitDependencies": ["platform", "router"],
  "targets": {
    "build-vite": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "vite build --config apps/i18n-workers-app/vite.config.ts"
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{options.outputPath}",
        "{workspaceRoot}/dist/apps/i18n-workers-app/.nitro",
        "{workspaceRoot}/dist/apps/i18n-workers-app/ssr",
        "{workspaceRoot}/dist/apps/i18n-workers-app/analog"
      ],
      "options": {
        "configFile": "apps/i18n-workers-app/vite.config.ts",
        "outputPath": "dist/apps/i18n-workers-app/client"
      },
      "defaultConfiguration": "production",
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "sourcemap": false,
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "i18n-workers-app:build",
        "port": 3200
      },
      "configurations": {
        "development": {
          "buildTarget": "i18n-workers-app:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "i18n-workers-app:build:production"
        }
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node tools/scripts/validate-i18n-workers.mjs"
      }
    }
  }
}
