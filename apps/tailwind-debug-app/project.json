{
  "name": "tailwind-debug-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/tailwind-debug-app/src",
  "prefix": "tdbg",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@analogjs/platform:vite",
      "dependsOn": ["platform:build", "router:build"],
      "outputs": ["{workspaceRoot}/dist/apps/tailwind-debug-app/analog"],
      "defaultConfiguration": "production",
      "options": {
        "configFile": "apps/tailwind-debug-app/vite.config.ts",
        "outputPath": "dist/apps/tailwind-debug-app/client"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "sourcemap": false,
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "@analogjs/platform:vite-dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "tailwind-debug-app:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "tailwind-debug-app:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "tailwind-debug-app:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-nitro": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "dist/apps/tailwind-debug-app/analog",
        "command": "node --unhandled-rejections=throw ./server/index.mjs",
        "env": {
          "PORT": "43040"
        }
      }
    },
    "test": {
      "dependsOn": ["platform:build", "router:build", "vitest-angular:build"],
      "outputs": [
        "{projectRoot}/coverage",
        "{workspaceRoot}/coverage/apps/tailwind-debug-app"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/tailwind-debug-app",
        "command": "pnpm exec tsgo -p tsconfig.app.json --noEmit"
      }
    }
  }
}
