{
  "name": "esbuild-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/esbuild-app/src",
  "tags": [],
  "implicitDependencies": ["platform", "router", "content"],
  "targets": {
    "build": {
      "executor": "@analogjs/platform:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/esbuild-app",
        "index": "apps/esbuild-app/src/index.html",
        "browser": "apps/esbuild-app/src/main.ts",
        "server": "apps/esbuild-app/src/main.server.ts",
        "outputMode": "server",
        "ssr": { "entry": "apps/esbuild-app/src/server.ts" },
        "prerender": true,
        "tsConfig": "apps/esbuild-app/tsconfig.app.json",
        "optimization": false,
        "outputHashing": "none",
        "security": { "allowedHosts": ["localhost"] },
        "analog": {
          "mermaid": true,
          "streaming": true,
          "sitemap": { "host": "https://analog.example" },
          "shikiOptions": {
            "container": "<div class=\"hl-wrap\">%s</div>"
          }
        }
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node apps/esbuild-app/verify-output.mjs"
      }
    },
    "verify-browser": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node apps/esbuild-app/verify-browser.mjs"
      }
    },
    "verify-dev-server": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/esbuild-app/verify-dev-server.mjs"
      }
    },
    "serve": {
      "executor": "@analogjs/platform:dev-server",
      "options": {
        "buildTarget": "esbuild-app:build"
      }
    }
  }
}
