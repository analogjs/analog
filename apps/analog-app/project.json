{
  "name": "analog-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/analog-app/src",
  "prefix": "analogjs",
  "tags": [],
  "implicitDependencies": [
    "vitest-angular",
    "storybook-angular",
    "platform",
    "router",
    "content"
  ],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{options.outputPath}",
        "{workspaceRoot}/dist/apps/analog-app/.nitro",
        "{workspaceRoot}/dist/apps/analog-app/ssr",
        "{workspaceRoot}/dist/apps/analog-app/analog"
      ],
      "options": {
        "configFile": "apps/analog-app/vite.config.ts",
        "outputPath": "dist/apps/analog-app/client"
      },
      "defaultConfiguration": "production",
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "sourcemap": false,
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "analog-app:build",
        "port": 3000
      },
      "configurations": {
        "development": {
          "buildTarget": "analog-app:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "analog-app:build:production"
        }
      }
    },
    "build-ng": {
      "executor": "@analogjs/platform:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/analog-app-ng",
        "index": "apps/analog-app/index-ng.html",
        "browser": "apps/analog-app/src/main.ts",
        "server": "apps/analog-app/src/main.server-ng.ts",
        "outputMode": "server",
        "ssr": {
          "entry": "apps/analog-app/src/server-ng.ts"
        },
        "prerender": true,
        "tsConfig": "apps/analog-app/tsconfig.app-ng.json",
        "styles": ["apps/analog-app/src/styles.css"],
        "assets": [
          {
            "glob": "favicon.ico",
            "input": "apps/analog-app",
            "output": "."
          },
          {
            "glob": "**/*",
            "input": "apps/analog-app/src/public",
            "output": "."
          }
        ],
        "optimization": false,
        "outputHashing": "none",
        "security": {
          "allowedHosts": ["localhost"]
        },
        "analog": {
          "additionalPagesDirs": ["/libs/shared/feature"],
          "additionalAPIDirs": ["/libs/shared/feature/src/api"]
        }
      },
      "configurations": {
        "production": {
          "optimization": true,
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/analog-app/src/environments/environment.ts",
              "with": "apps/analog-app/src/environments/environment.prod.ts"
            }
          ]
        }
      }
    },
    "serve-ng": {
      "executor": "@analogjs/platform:dev-server",
      "options": {
        "buildTarget": "analog-app:build-ng",
        "port": 3001
      }
    },
    "serve-nitro": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "",
        "command": "PORT=3000 node dist/apps/analog-app/analog/server/index.mjs"
      },
      "dependsOn": ["build"]
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "browserTarget": "analog-app:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{projectRoot}/coverage"],
      "dependsOn": ["^build"]
    },
    "storybook": {
      "executor": "@analogjs/storybook-angular:start-storybook",
      "dependsOn": ["^build"],
      "options": {
        "configDir": "apps/analog-app/.storybook",
        "compodoc": false,
        "compodocArgs": ["-e", "json", "-d", "."],
        "port": 6006,
        "styles": ["apps/analog-app/src/styles.css"],
        "stylePreprocessorOptions": {
          "loadPaths": []
        }
      }
    },
    "build-storybook": {
      "executor": "@analogjs/storybook-angular:build-storybook",
      "options": {
        "configDir": "apps/analog-app/.storybook",
        "compodoc": false,
        "compodocArgs": ["-e", "json", "-d", "."],
        "outputDir": "dist/apps/storybook-static",
        "styles": ["apps/analog-app/src/styles.css"],
        "stylePreprocessorOptions": {
          "loadPaths": []
        }
      }
    }
  }
}
