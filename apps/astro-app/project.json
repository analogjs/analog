{
  "name": "astro-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/astro-app/src",
  "tags": [],
  "targets": {
    "serve": {
      "command": "astro dev --port 43030",
      "options": {
        "cwd": "apps/astro-app"
      }
    },
    "build": {
      "command": "astro build --root apps/astro-app",
      "dependsOn": ["astro-angular:build"]
    },
    "preview": {
      "command": "astro preview --port 43030",
      "options": {
        "cwd": "apps/astro-app"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/astro-app",
        "command": "pnpm exec tsgo -p tsconfig.app.json --noEmit"
      }
    }
  }
}
