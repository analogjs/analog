{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "workspaceLayout": {
    "libsDir": "packages"
  },
  "cli": {
    "packageManager": "pnpm"
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "serve": {
      "dependsOn": ["^build"]
    },
    "build-package": {
      "cache": false
    },
    "@nx/js:tsc": {
      "cache": false
    },
    "@nx/eslint:lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*"
      ],
      "cache": true
    },
    "@angular-devkit/build-angular:application": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    }
  },
  "generators": {
    "@nx/angular:application": {
      "e2eTestRunner": "cypress",
      "linter": "eslint",
      "style": "css",
      "unitTestRunner": "vitest"
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "vitest-analog"
    },
    "@nx/angular:component": {
      "style": "css"
    }
  },
  "defaultProject": "analog-app",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals", "projectSpecificFiles"],
    "sharedGlobals": [],
    "production": [
      "default",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/**/*.stories.@(js|jsx|ts|tsx|mdx)",
      "!{projectRoot}/.storybook/**/*",
      "!{projectRoot}/tsconfig.storybook.json",
      "!{projectRoot}/eslint.config.mjs"
    ],
    "projectSpecificFiles": []
  },
  "defaultBase": "beta",
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "eslint:lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testMode": "run",
        "testTargetName": "test"
      },
      "include": [
        "apps/analog-app/**/*",
        "apps/docs-analog/**/*",
        "apps/tailwind-debug-app/**/*",
        "apps/tanstack-query-app/**/*",
        "libs/top-bar/**/*",
        "packages/astro-angular/**/*",
        "packages/content/**/*",
        "packages/content-plugin/**/*",
        "packages/create-analog/**/*",
        "packages/nx-plugin/**/*",
        "packages/platform/**/*",
        "packages/router/**/*",
        "packages/storybook-angular/**/*",
        "packages/vite-plugin-angular/**/*",
        "packages/vite-plugin-angular-tools/**/*",
        "packages/vite-plugin-nitro/**/*",
        "packages/vitest-angular-tools/**/*"
      ]
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testMode": "run",
        "testTargetName": "vitest"
      },
      "include": [
        "apps/astro-app-e2e-playwright/**/*",
        "apps/streaming-app-e2e-playwright/**/*"
      ]
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testMode": "run",
        "testTargetName": "tests"
      },
      "include": ["libs/card/**/*"]
    }
  ],
  "analytics": false,
  "nxCloudId": "6a440f229f68ea99f27e4235",
  "affected": {
    "legacy": true
  }
}
