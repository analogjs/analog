{
  "$schema": "http://json-schema.org/schema",
  "cli": "nx",
  "$id": "Preset",
  "title": "",
  "type": "object",
  "properties": {
    "analogAppName": {
      "type": "string",
      "description": "",
      "x-prompt": "What name would you like to use for your Analog app?"
    },
    "addTailwind": {
      "type": "boolean",
      "description": "Adds tailwind if set to true.",
      "x-prompt": "Add TailwindCSS for styling?",
      "default": true
    },
    "linter": {
      "description": "The tool to use for running lint checks. `oxlint` requires Nx 23.2 or newer.",
      "type": "string",
      "enum": ["eslint", "oxlint", "none"],
      "default": "eslint"
    },
    "tags": {
      "type": "string",
      "description": "Add tags to the project (used for linting)",
      "alias": "t"
    },
    "skipFormat": {
      "description": "Skip formatting files.",
      "type": "boolean",
      "default": false,
      "x-priority": "internal"
    }
  },
  "required": ["analogAppName"]
}
