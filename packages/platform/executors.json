{
  "$schema": "../../node_modules/@angular-devkit/architect/src/builders-schema.json",
  "builders": {
    "vite-dev-server": "@analogjs/vite-plugin-angular:vite-dev-server",
    "vite": "@analogjs/vite-plugin-angular:vite",
    "vitest": "@analogjs/vitest-angular:test",
    "application": {
      "implementation": "./src/lib/esbuild/builders/application.impl",
      "schema": "./src/lib/esbuild/builders/application.schema.json",
      "description": "Builds an Angular application with Analog file-based routes using the esbuild-based application builder"
    },
    "dev-server": {
      "implementation": "./src/lib/esbuild/builders/dev-server.impl",
      "schema": "./src/lib/esbuild/builders/dev-server.schema.json",
      "description": "Serves an Angular application with Analog file-based routes using the esbuild-based dev server"
    }
  },
  "executors": {
    "vite-dev-server": {
      "implementation": "./src/lib/nx-plugin/src/executors/vite-dev-server/vite-dev-server.impl",
      "schema": "./src/lib/nx-plugin/src/executors/vite-dev-server/schema.json",
      "description": "Vite dev server."
    },
    "vite": {
      "implementation": "./src/lib/nx-plugin/src/executors/vite/vite.impl",
      "schema": "./src/lib/nx-plugin/src/executors/vite/schema.json",
      "description": "Build with Vite."
    },
    "vitest": {
      "implementation": "./src/lib/nx-plugin/src/executors/vitest/vitest.impl",
      "schema": "./src/lib/nx-plugin/src/executors/vitest/schema.json",
      "description": "Test with Vitest"
    }
  }
}
