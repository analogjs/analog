{
  "name": "vite-plugin-angular-tools",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/vite-plugin-angular-tools/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["vite-plugin-angular:build-self"],
      "outputs": [
        "{workspaceRoot}/packages/vite-plugin-angular/dist/src/lib/tools"
      ],
      "options": {
        "command": "vite build -c packages/vite-plugin-angular-tools/vite.config.lib.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/vite-plugin-angular-tools",
        "command": "pnpm exec tsgo --build tsconfig.lib.json --emitDeclarationOnly"
      }
    }
  }
}
