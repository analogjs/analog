{
  "name": "tsrx-angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/tsrx-angular/src",
  "projectType": "library",
  "tags": [],
  "implicitDependencies": ["vite-plugin-angular"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["vite-plugin-angular:build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "vite build -c packages/tsrx-angular/vite.config.lib.ts"
      }
    },
    "test": {
      "dependsOn": ["vite-plugin-angular:build"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/tsrx-angular",
        "command": "pnpm exec tsgo --build tsconfig.lib.json --emitDeclarationOnly"
      }
    }
  }
}
